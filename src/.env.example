# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Phase 2 API ─────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 32  (NEVER ship the default)
JWT_SECRET="CHANGE_ME_use_openssl_rand_hex_32"
JWT_EXPIRES_IN="3600"
JWT_REFRESH_EXPIRES_IN="604800"
MAX_UPLOAD_BYTES="5242880"

# ── Phase 3 Database ────────────────────────────────────────────────────────
# PostgreSQL connection string. Leave unset for in-memory development mode.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/konstrivo"
# Separate PostgreSQL connection string for test-only integration runs.
# Must be different from DATABASE_URL and must not point to production.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST:5432/test_database?sslmode=require"

# ── Phase 1.1 Admin Bootstrap ────────────────────────────────────────────────
# Set these to create the first admin user on startup.
# Leave unset to skip admin bootstrap (no admin user created).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email settings (optional) ─────────────────────────────────────────────
# EmailJS REST API — used to send password reset emails (server-side only).
# Service ID / Template ID / Public Key from the EmailJS dashboard.
# Leave empty to disable email sending.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Public frontend URL used to build reset links.
# REQUIRED in production: must be an absolute http(s) URL, NOT localhost.
# If missing/invalid in production the server silently skips reset emails
# (never sends a localhost link). Localhost is acceptable for local dev/tests.
PUBLIC_APP_URL=http://localhost:5173

# ── Phase E Flouci Payments ─────────────────────────────────────────────────
# Flouci Payment API v2 credentials (https://docs.flouci.com).
# Get PUBLIC_KEY / PRIVATE_KEY from your Flouci developer dashboard
# (a TEST APP is provided automatically for integration testing).
# Leave unset to disable payments — the adapter fails CLOSED (throws) when
# credentials are missing; the rest of the server is unaffected.
FLOUCI_PUBLIC_KEY=
FLOUCI_SECRET_KEY=
# Override only for tests/staging against a mock server. Defaults to the
# official API: https://developers.flouci.com/api/v2
FLOUCI_BASE_URL=
# Public URLs Flouci redirects the user to after success/failure.
FLOUCI_SUCCESS_LINK=http://localhost:5173/payment/success
FLOUCI_FAIL_LINK=http://localhost:5173/payment/fail
# Server-to-server notification URL Flouci POSTs the transaction outcome to.
FLOUCI_WEBHOOK_URL=

